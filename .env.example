# ---- Dev: copy to .env (read by the app when run with uvicorn) ----

# Shared dev MongoDB + Redis (global containers on the default ports)
MONGODB_URL=mongodb://admin:admin123@localhost:27017
# Database 1 keeps shortify's keys apart from other projects sharing global Redis
REDIS_URL=redis://:dev_pass@localhost:6379/1

# Standalone (docker-compose.dev.yaml) instead:
# MONGODB_URL=mongodb://admin:admin123@localhost:27018
# REDIS_URL=redis://:dev_pass@localhost:6380/0

MONGODB_DB_NAME=shortify
BASE_URL=http://localhost:8000

# ---- Prod: copy to .env.prod (read by docker-compose.prod.yaml) ----
# The compose file builds MONGODB_URL and REDIS_URL from these, so passwords must be URL-safe
# (letters and digits, or percent-encode anything else).

# MONGO_USERNAME=shortify
# MONGO_PASSWORD=change-me
# REDIS_PASSWORD=change-me
# BASE_URL=https://your-domain.com
